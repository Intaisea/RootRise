MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rootrise
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters
# Keep your owner/admin account out of client code.
ADMIN_EMAIL=owner@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-12-character-password
# Production web origin(s), comma-separated; include your HTTPS site and this Android WebView origin.
ALLOWED_ORIGINS=http://localhost:3000,https://appassets.androidplatform.net
PUBLIC_BASE_URL=http://localhost:3000
# Set up SMTP to enable forgot-password and admin reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RootRise Support <support@example.com>
# Remove ADMIN_INITIAL_PASSWORD from .env after the first successful seed-admin run.
